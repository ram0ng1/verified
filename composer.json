{
    "name": "ramon/verified",
    "description": "User verification for Flarum, with a X (Twitter)-style verified badge and admin-managed verification requests.",
    "keywords": [
        "flarum",
        "verified",
        "badge",
        "verification"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ramon Guilherme",
            "email": "ramon@ramonguilherme.com.br",
            "homepage": "https://ramonguilherme.com.br",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0.0"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpstan/phpstan": "^2.0",
        "flarum/gdpr": "^2.0"
    },
    "suggest": {
        "flarum/gdpr": "Required for data-export, anonymization and erasure integration (^2.0)."
    },
    "autoload": {
        "psr-4": {
            "Ramon\\Verified\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Verified",
            "category": "feature",
            "icon": {
                "image": "icon.svg",
                "backgroundColor": "#fff",
                "color": "#fff"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "analyse": "phpstan analyse"
    }
}
