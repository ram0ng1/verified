includes:
    - vendor/flarum/phpstan/extension.neon

parameters:
    level: 6
    paths:
        - extend.php
        - src
        - migrations
    excludePaths:
        analyse:
            - *.blade.php
    # Declara as classes da integração opcional ramon/audit (não é dependência
    # composer, então a CI não a autoloada). Só símbolos, não é analisado.
    scanFiles:
        - stubs/ramon-audit.php
    databaseMigrationsPath: ['migrations']
    treatPhpDocTypesAsCertain: false
